<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>المنصة القومية للتقارير الصحية والترصد الوبائي</title>
<style>
:root{--bg:#eef3f8;--card:#fff;--text:#1d2630;--muted:#667085;--border:#d9e0e8;--pri:#1560c7;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
body{margin:0;font-family:Tahoma,Arial,sans-serif;background:linear-gradient(#dcebfa,var(--bg) 320px);color:var(--text);min-height:100vh}
.hidden{display:none!important}
header{background:linear-gradient(#2a7fe0,#0b3a7a);color:#fff;padding:16px;text-align:center;box-shadow:0 4px 0 #072a5a}
.brand{display:flex;align-items:center;justify-content:space-between;gap:12px}
.logo-img img{width:50px;height:50px;border-radius:8px;background:#fff;padding:4px;box-shadow:0 2px 6px rgba(0,0,0,.3)}
.logo-placeholder{width:50px;height:50px;border:2px dashed rgba(255,255,255,.7);border-radius:8px;flex-shrink:0}
.header-text{text-align:center;flex:1}
.header-text .t2{font-size:14px;font-weight:bold;color:#ffe066;margin-bottom:2px}
.header-text .t3{font-size:13px;font-weight:bold;color:#cfe3ff;margin-bottom:2px}
.header-text h1{font-size:clamp(14px,4.2vw,18px);font-weight:900;line-height:1.4;margin:0;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.4)}
main{max-width:520px;margin:auto;padding:16px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 4px 12px rgba(0,0,0,.08)}
.card h3{margin:0 0 6px}
label{display:block;margin:12px 0 5px;font-size:14px;color:var(--muted)}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--border);border-radius:10px;font-size:16px;background:#f7f9fc;color:var(--text);font-family:inherit}
textarea{min-height:70px;resize:vertical}
.tile,.btn{--c:linear-gradient(#3fa4ff,#1560c7);--s:#0b3a7a;background:var(--c);color:#fff;border:none;border-radius:16px;font-family:inherit;font-weight:bold;cursor:pointer;text-shadow:0 1px 2px rgba(0,0,0,.3);box-shadow:0 7px 0 var(--s),0 12px 20px rgba(0,0,0,.25),inset 0 2px 0 rgba(255,255,255,.4);transform:translateY(0);transition:transform .08s,box-shadow .08s;text-decoration:none;display:block}
.tile:active,.btn:active{transform:translateY(5px);box-shadow:0 2px 0 var(--s),0 4px 8px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.3)}
.tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:118px;padding:14px 8px;font-size:16px}
.tile .ic{font-size:32px}
.tile.full{grid-column:span 2;min-height:96px}
.btn{width:100%;padding:14px;font-size:17px;margin-top:16px;text-align:center}
.blue{--c:linear-gradient(#3fa4ff,#1560c7);--s:#0b3a7a}
.red{--c:linear-gradient(#ff6a5e,#d82a1e);--s:#8e110a}
.green{--c:linear-gradient(#4cd47a,#1e9a4a);--s:#0f6a31}
.gold{--c:linear-gradient(#ffe066,#e8ad00);--s:#9a7400;color:#2a2000;text-shadow:none}
.gray{--c:linear-gradient(#8a96a6,#56627a);--s:#333d4f}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.link{background:none;border:none;color:var(--pri);font-size:15px;cursor:pointer;margin-top:14px;width:100%;font-family:inherit}
.small{padding:6px 12px;border:1px solid var(--border);border-radius:8px;background:#fff;color:var(--text);cursor:pointer;font-size:13px;font-family:inherit}
.small.del{color:#c0392b;border-color:#c0392b}
.rec{border-bottom:1px solid var(--border);padding:12px 0}
.rec:last-child{border-bottom:none}
.badge{display:inline-block;padding:2px 8px;border-radius:10px;background:#eef3f8;font-size:12px;color:var(--muted);margin-inline-start:4px}
.muted{color:var(--muted);font-size:13px;line-height:1.7}
.stat{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--border);font-size:16px}
.stat:last-child{border-bottom:none}
.empty{text-align:center;color:var(--muted);padding:20px}
.back{margin-bottom:12px}
.back .small{padding:8px 14px}
.note{background:#fff7d6;border-radius:10px;padding:10px;font-size:13px;color:#6b5600;margin-top:12px}
#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:10px 18px;border-radius:10px;font-size:14px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:10;max-width:90%;text-align:center}
#toast.show{opacity:1}
body{background:radial-gradient(circle at top right,#cfe6ff,transparent 45%),radial-gradient(circle at bottom left,#d9f5e8,transparent 40%),var(--bg)!important}
header{border-bottom-left-radius:28px;border-bottom-right-radius:28px}
.card{border-radius:20px;border:none;box-shadow:0 10px 25px rgba(11,58,122,.12)}
.tile .ic{filter:drop-shadow(0 2px 3px rgba(0,0,0,.3))}
.states{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.st{padding:14px 6px;border:none;border-radius:14px;background:linear-gradient(#3fa4ff,#1560c7);color:#fff;font-family:inherit;font-weight:bold;font-size:14px;line-height:1.5;box-shadow:0 5px 0 #0b3a7a,0 8px 14px rgba(0,0,0,.2);cursor:pointer;transition:transform .08s,box-shadow .08s}
.st:active{transform:translateY(4px);box-shadow:0 1px 0 #0b3a7a}
.foot{text-align:center;color:var(--muted);font-size:12px;line-height:1.8;padding:18px 12px 28px}
#fState{margin-top:4px}
.back .small{padding:8px 14px;border:none;border-radius:12px;background:linear-gradient(#3fa4ff,#1560c7);color:#fff;font-weight:bold;font-family:inherit;font-size:13px;box-shadow:0 4px 0 #0b3a7a,0 6px 10px rgba(0,0,0,.2);cursor:pointer;transition:transform .08s,box-shadow .08s}
.back .small:active{transform:translateY(3px);box-shadow:0 1px 0 #0b3a7a}
.tools{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:12px}
.pill{padding:8px 12px;border:none;border-radius:999px;background:linear-gradient(#2a6fd6,#0b3a7a);color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35);font-weight:bold;font-family:inherit;font-size:13px;box-shadow:0 3px 0 #06234d,0 5px 10px rgba(0,0,0,.25),inset 0 1px 0 rgba(255,255,255,.35);cursor:pointer;transition:transform .08s,box-shadow .08s}
.pill:active{transform:translateY(2px);box-shadow:0 1px 0 #06234d}
:root[data-theme="dark"]{--bg:#15191e;--card:#1f252c;--text:#e8edf2;--muted:#9aa5b1;--border:#333c46}
:root[data-theme="dark"] body{background:var(--bg)!important}
:root[data-theme="dark"] input,:root[data-theme="dark"] select,:root[data-theme="dark"] textarea{background:#11151a!important;color:var(--text)!important;border-color:var(--border)!important}
:root[data-theme="dark"] .pill{background:linear-gradient(#2f6fcf,#123f86);color:#fff;box-shadow:0 3px 0 #061a38,0 5px 10px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.3)}
:root[data-theme="dark"] .card{box-shadow:0 10px 25px rgba(0,0,0,.4)}
:root[data-theme="dark"] .badge{background:#11151a}
:root[data-theme="dark"] .gold{color:#2a2000}
header{position:relative;margin:8px 8px 0;padding:20px 18px 16px;border-radius:22px;border:3px double rgba(255,255,255,.92);box-shadow:0 6px 0 #072a5a,0 10px 18px rgba(0,0,0,.25),inset 0 2px 0 rgba(255,255,255,.3)}
header::before{content:"";position:absolute;inset:6px;border:1px solid rgba(255,224,102,.95);border-radius:16px;pointer-events:none}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}
.grid3 .tile{min-height:92px;font-size:14px;padding:10px 4px}
.grid3 .tile .ic{font-size:26px}
.sec-t{margin:18px 4px 0;font-weight:bold;color:var(--pri)}
.epi-actions{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0;align-items:center}
.ebtn{display:inline-block;border:none;border-radius:12px;padding:9px 14px;font-weight:bold;font-family:inherit;font-size:13px;color:#fff;text-decoration:none;cursor:pointer;text-shadow:0 1px 2px rgba(0,0,0,.3);background:linear-gradient(#3fa4ff,#1560c7);box-shadow:0 4px 0 #0b3a7a,0 6px 10px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.35)}
.ebtn:active{transform:translateY(3px);box-shadow:0 1px 0 #0b3a7a}
.ebtn.green{background:linear-gradient(#4cd47a,#1e9a4a);box-shadow:0 4px 0 #0f6a31,0 6px 10px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.35)}
.ebtn.red{background:linear-gradient(#ff6a5e,#d82a1e);box-shadow:0 4px 0 #8e110a,0 6px 10px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.35)}
.ebtn.gray{background:linear-gradient(#8a96a6,#56627a);box-shadow:0 4px 0 #333d4f,0 6px 10px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.35)}
.ebtn.gold{background:linear-gradient(#ffe066,#e8ad00);color:#2a2000;text-shadow:none;box-shadow:0 4px 0 #9a7400,0 6px 10px rgba(0,0,0,.2),inset 0 2px 0 rgba(255,255,255,.5)}
.epiAlert{padding:9px 12px;border-radius:12px;background:linear-gradient(#fff1f0,#ffe0dd);border:1px solid #f1a9a2;color:#a11d12;font-weight:bold;font-size:14px;margin:6px 0 10px}
.epiCase{border:1px solid var(--border);border-radius:14px;padding:10px;margin:8px 0;background:var(--card)}
.epiCase .hist{margin-top:8px;padding:8px;border-radius:10px;background:rgba(21,96,199,.07);font-size:12.5px;line-height:1.8}
.badge.red{background:#ffe0dd;color:#a11d12}
.epiT{width:100%;border-collapse:separate;border-spacing:0;font-size:12.5px;background:var(--card)}
.epiT th,.epiT td{border-bottom:1px solid var(--border);border-left:1px solid var(--border);padding:6px 5px;text-align:center}
.epiT th{background:#eef3f8;color:#0b3a7a}
.epiT td.label{text-align:right;font-weight:bold;white-space:nowrap}
.epiT tr.ct td{border-top:2px solid #1560c7;background:#e8f1fc;font-weight:bold;color:#0b3a7a}
:root[data-theme="dark"] .epiT th{background:#2a3441;color:#e8edf2}
:root[data-theme="dark"] .epiT tr.ct td{background:#223049;color:#cfe3ff}
.xs{overflow-x:auto;margin-bottom:10px;border-radius:10px;border:1px solid var(--border)}
.epiH{margin:14px 0 6px;color:#0b3a7a}
:root[data-theme="dark"] .epiH{color:#9cc4ff}
.row2{display:flex;gap:10px;align-items:flex-end}
.row2>*{flex:1;min-width:0}
.epi-modal{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:60;display:flex;align-items:center;justify-content:center;padding:16px}
.epi-box{background:var(--card);color:var(--text);border-radius:18px;padding:18px;max-width:420px;width:100%;box-shadow:0 12px 30px rgba(0,0,0,.4);border-top:6px solid #d82a1e}
.print-only{display:none}
.phead{text-align:center;border:3px double #0b3a7a;border-radius:10px;padding:8px 6px;margin-bottom:12px}
.phead .o{font-weight:bold;font-size:15px;color:#0b3a7a}.phead .t{font-size:19px;font-weight:bold;color:#0b3a7a;margin:3px 0 6px;padding-bottom:6px;border-bottom:1px solid #999}.phead .rt{font-size:16px;font-weight:bold;margin:2px 0}.phead .p,.phead .d{font-size:12px}
.pfoot{display:none;justify-content:space-between;margin-top:28px;font-size:12px}
.notesP{white-space:pre-wrap;border:1px solid #999;min-height:40px;padding:6px;font-size:12px}
@media print{
  #app>header,.foot,.back,.noprint,#auth,#toast,.epi-modal{display:none!important}
  .print-only{display:block!important}.pfoot{display:flex!important}
  body{background:#fff!important;color:#000!important;zoom:1!important}
  main{padding:0!important;max-width:none!important}
  .card{box-shadow:none!important;border:none!important;padding:0!important;background:#fff!important}
  .xs{overflow:visible!important;border:none!important}
  .epiT{font-size:10.5px}.epiT th{background:#eee!important;color:#000!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .epiT tr.ct td{background:#e4e4e4!important;color:#000!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .epiCase{break-inside:avoid;box-shadow:none!important}
  table{break-inside:auto}tr{break-inside:avoid}
  @page{size:A4;margin:10mm}
  @page wide{size:A4 landscape;margin:10mm}
  [data-view="rpt-nine"],[data-view="rpt-annual"]{page:wide}
}
</style>
</head>
<body>

<div id="auth">
  <header>
    <div class="brand">
      <div class="logo-img"><img src="logo.jpg" alt="شعار"></div>
      <div class="header-text">
        <div class="t2">جمهورية السودان · وزارة الصحة</div>
        <div class="t3">إدارة الشؤون الصحية محلية أم القرى</div>
        <h1>المنصة القومية للتقارير الصحية والترصد الوبائي</h1>
      </div>
      <div class="logo-placeholder"></div>
    </div>
  </header>
  <main>
    <div class="card" id="loginBox">
      <h3>تسجيل الدخول</h3>
      <label for="lPhone">رقم التلفون</label>
      <input id="lPhone" inputmode="tel" placeholder="مثال: 0910211755">
      <label for="lPass">كلمة السر</label>
      <input id="lPass" type="password" placeholder="كلمة السر">
      <button class="btn blue" id="loginBtn">دخول</button>
      <button class="link" id="showReg">أنشئ حساباً جديداً</button>
    </div>

    <div class="card hidden" id="regBox">
      <h3>إنشاء حساب جديد</h3>
      <label for="rName">الاسم</label>
      <input id="rName" placeholder="الاسم الكامل">
      <label for="rPhone">رقم التلفون</label>
      <input id="rPhone" inputmode="tel" placeholder="رقم التلفون">
      <label for="rPass">كلمة السر</label>
      <input id="rPass" type="password" placeholder="4 أحرف أو أكثر">
      <label for="rPass2">تأكيد كلمة السر</label>
      <input id="rPass2" type="password" placeholder="أعد كتابة كلمة السر">
      <button class="btn green" id="regBtn">إنشاء الحساب</button>
      <button class="link" id="backLogin">لديّ حساب، تسجيل الدخول</button>
    </div>

    <div class="card">
      <h3>أرقام المدراء للتواصل</h3>
      <div class="contacts" data-contacts></div>
    </div>
  </main>
</div>

<div id="app" class="hidden">
  <header>
    <div class="brand">
      <div class="logo-img"><img src="logo.jpg" alt="شعار"></div>
      <div class="header-text">
        <div class="t2">جمهورية السودان · وزارة الصحة</div>
        <div class="t3">إدارة الشؤون الصحية محلية أم القرى</div>
        <h1>المنصة القومية للتقارير الصحية والترصد الوبائي</h1>
      </div>
      <div class="logo-placeholder"></div>
    </div>
    <div style="margin-top:10px"><button class="small" id="logoutBtn">تسجيل خروج</button></div>
  </header>

  <main>
    <!-- أدوات أعلى الشاشة -->
    <div class="tools">
      <button class="pill" id="fMinus">A−</button>
      <button class="pill" id="fPlus">A+</button>
      <button class="pill" id="visits">👁 الزوار</button>
      <button class="pill" id="shareBtn">🔗 رابط التطبيق</button>
      <button class="pill" id="nightBtn">🌙 ليلي</button>
    </div>

    <div class="grid" data-view="home">
      <button class="tile red full" data-go="new"><span class="ic">🚨</span>بلاغ جديد</button>
      <button class="tile gold full" data-go="contacts"><span class="ic">📞</span>أرقام المدراء</button>
      <button class="tile blue full" id="usersBtn" data-go="users" style="display:none;"><span class="ic">👥</span>المستخدمون والصلاحيات</button>
      <button class="tile blue" data-go="list"><span class="ic">📋</span>السجل</button>
      <button class="tile green" data-go="stats"><span class="ic">📊</span>الإحصائيات</button>
      <button class="tile gray" data-go="reports"><span class="ic">📤</span>التقارير</button>
      <button class="tile gold" data-go="states"><span class="ic">🗺️</span>الهيكل الإداري</button>
    </div>

    <div class="hidden" data-view="new">
      <div class="back"><button class="small" data-go="home">← رجوع للقائمة</button></div>
      <div class="card">
        <label for="state">الولاية</label>
        <select id="state">
          <option value="ولاية الخرطوم">ولاية الخرطوم</option>
          <option value="ولاية الجزيرة">ولاية الجزيرة</option>
          <option value="ولاية النيل الأبيض">ولاية النيل الأبيض</option>
          <option value="ولاية النيل الأزرق">ولاية النيل الأزرق</option>
          <option value="ولاية سنار">ولاية سنار</option>
          <option value="ولاية القضارف">ولاية القضارف</option>
          <option value="ولاية كسلا">ولاية كسلا</option>
          <option value="ولاية البحر الأحمر">ولاية البحر الأحمر</option>
          <option value="ولاية نهر النيل">ولاية نهر النيل</option>
          <option value="الولاية الشمالية">الولاية الشمالية</option>
          <option value="ولاية شمال كردفان">ولاية شمال كردفان</option>
          <option value="ولاية جنوب كردفان">ولاية جنوب كردفان</option>
          <option value="ولاية غرب كردفان">ولاية غرب كردفان</option>
          <option value="ولاية شمال دارفور">ولاية شمال دارفور</option>
          <option value="ولاية جنوب دارفور">ولاية جنوب دارفور</option>
          <option value="ولاية شرق دارفور">ولاية شرق دارفور</option>
          <option value="ولاية غرب دارفور">ولاية غرب دارفور</option>
          <option value="ولاية وسط دارفور">ولاية وسط دارفور</option>
        </select>
        <label for="locality">المحلية</label>
        <select id="locality"></select>
        <label for="unit">الوحدة</label>
        <select id="unit">
          <option value="وحدة جنوب">وحدة جنوب</option>
          <option value="وحدة وسط">وحدة وسط</option>
          <option value="وحدة شمال">وحدة شمال</option>
        </select>
        <label for="empNo">الرقم الوظيفي</label>
        <input id="empNo" inputmode="numeric" placeholder="مثال: 1024">
        <label for="empName">اسم الموظف</label>
        <input id="empName" placeholder="الاسم الكامل">
        <label for="dept">القسم</label>
        <input id="dept" placeholder="مثال: المختبر">
        <label for="disease">المرض</label>
        <select id="disease">
          <option value="ملاريا">ملاريا</option>
          <option value="حمى الضنك">حمى الضنك</option>
          <option value="أخرى">أخرى</option>
        </select>
        <div id="otherWrap" class="hidden">
          <label for="otherDisease">اسم المرض</label>
          <input id="otherDisease" placeholder="اكتب اسم المرض">
        </div>
        <label for="date">تاريخ التشخيص</label>
        <input id="date" type="date">
        <label for="status">الحالة</label>
        <select id="status">
          <option value="مشتبه به">مشتبه به</option>
          <option value="مؤكد">مؤكد</option>
          <option value="تحت العلاج">تحت العلاج</option>
          <option value="متعافٍ">متعافٍ</option>
        </select>
        <label for="symptoms">الأعراض</label>
        <textarea id="symptoms" placeholder="مثال: حمى، صداع، آلام في المفاصل"></textarea>
        <label for="notes">ملاحظات</label>
        <textarea id="notes" placeholder="أي ملاحظات إضافية"></textarea>
        <button class="btn red" id="saveBtn">حفظ البلاغ</button>
      </div>
    </div>

