<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
/* ===== الإعدادات (لا تُغيَّر) ===== */
const firebaseConfig = {
  apiKey: "AIzaSyD4Iesxn_85M4cwfDkfrhezBkAFtx45xC0",
  authDomain: "cq-center-f7775.firebaseapp.com",
  projectId: "cq-center-f7775",
  storageBucket: "cq-center-f7775.firebasestorage.app",
  messagingSenderId: "779273740183",
  appId: "1:779273740183:web:789956f5c7d0d2ca0aaed2"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

const MANAGERS = ["0910211755"];
const $ = id => document.getElementById(id);
let me = null, reports = [], registering = false;

const normPhone = s => String(s || "").replace(/\D/g, "");
const emailOf = p => p + "@cq-center.app";
const ymd = d => new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

const ROLE_NAMES = {ministry:"وزارة الصحة الاتحادية", state:"مسؤول الولاية", locality:"إدارة المحلية", center:"مدير مركز صحي", lab:"مدير معمل", entry:"مدخل بيانات"};
const LVL_NAMES = {ministry:"المنصة القومية للتقارير الصحية والترصد الوبائي", state:"ولاية الجزيرة", locality:"إدارة الشؤون الصحية محلية أم القرى", center:"مركز صحي", lab:"معمل", entry:"المنصة القومية للتقارير الصحية"};

/* ===== تطبيق الدور على الواجهة (للعرض فقط؛ الحماية الحقيقية في قواعد Firestore) ===== */
function applyRole(role) {
  document.body.dataset.role = role;
  $("who").textContent = "الدور: " + ROLE_NAMES[role];
  $("lvl").textContent = LVL_NAMES[role];
  document.querySelectorAll("[data-role-btn]").forEach(b => b.classList.toggle("on", b.dataset.roleBtn === role));
}
document.querySelectorAll("[data-role-btn]").forEach(b => b.addEventListener("click", () => {
  applyRole(b.dataset.roleBtn);
  go("home");
}));

/* ===== التنقل ===== */
function go(v) {
  document.querySelectorAll(".screen").forEach(s => s.classList.toggle("on", s.id === "s-" + v));
  if (v === "new") $("date").value = ymd(new Date());
  if (v === "list") renderList();
  if (v === "stats") renderStats();
  window.scrollTo(0, 0);
}
document.querySelectorAll("[data-go]").forEach(b => b.addEventListener("click", () => go(b.dataset.go)));

/* ===== الدخول والتسجيل ===== */
function showReg(on) { $("loginBox").classList.toggle("hidden", on); $("regBox").classList.toggle("hidden", !on); }
$("showReg").addEventListener("click", () => showReg(true));
$("backLogin").addEventListener("click", () => showReg(false));

$("loginBtn").addEventListener("click", async () => {
  const p = normPhone($("lPhone").value);
  if (p.length < 9) return alert("رقم التلفون غير صحيح");
  try { await auth.signInWithEmailAndPassword(emailOf(p), $("lPass").value); }
  catch (e) { alert("الرقم أو كلمة السر غير صحيحة"); }
});

$("regBtn").addEventListener("click", async () => {
  const name = $("rName").value.trim(), p = normPhone($("rPhone").value), pw = $("rPass").value;
  if (!name) return alert("اكتب الاسم");
  if (p.length < 9) return alert("رقم التلفون غير صحيح");
  if (pw !== $("rPass2").value) return alert("كلمتا السر غير متطابقتين");
  registering = true;
  try {
    const cred = await auth.createUserWithEmailAndPassword(emailOf(p), pw);
    await db.collection("users").doc(cred.user.uid).set({ name, phone: p, isManager: false });
    registering = false;
    await enter(cred.user.uid);
  } catch (e) {
    registering = false;
    alert("هذا الرقم مسجل مسبقاً أو حدث خطأ في الاتصال");
  }
});

$("logoutBtn").addEventListener("click", () => auth.signOut());

auth.onAuthStateChanged(async user => {
  if (registering) return;
  if (!user) {
    me = null;
    $("app").classList.add("hidden");
    $("auth").classList.remove("hidden");
    return;
  }
  await enter(user.uid);
});

async function enter(uid) {
  const snap = await db.collection("users").doc(uid).get();
  if (!snap.exists) return;
  me = { uid, ...snap.data() };
  if (MANAGERS.includes(me.phone)) me.isManager = true;
  $("auth").classList.add("hidden");
  $("app").classList.remove("hidden");
  applyRole(me.isManager ? "locality" : "entry");
  await loadReports();
  go("home");
}

async function loadReports() {
  try {
    const q = me.isManager ? db.collection("reports") : db.collection("reports").where("owner", "==", me.uid);
    const snap = await q.get();
    reports = snap.docs.map(d => ({ id: d.id, ...d.data() })).sort((a, b) => (b.created || 0) - (a.created || 0));
  } catch (e) { reports = []; }
}

/* ===== بلاغ جديد ===== */
$("disease").addEventListener("change", () => $("otherWrap").classList.toggle("hidden", $("disease").value !== "أخرى"));

$("saveBtn").addEventListener("click", async () => {
  const no = $("empNo").value.trim(), name = $("empName").value.trim();
  let dz = $("disease").value;
  if (dz === "أخرى") dz = $("otherDisease").value.trim();
  if (!no) return alert("أدخل الرقم الوظيفي");
  if (!dz) return alert("أدخل اسم المرض");
  $("saveBtn").disabled = true;
  try {
    await db.collection("reports").add({
      owner: me.uid, by: me.name, state: $("state").value, locality: $("locality").value,
      no, name, disease: dz, date: $("date").value, status: $("status").value,
      symptoms: $("symptoms").value.trim(), created: Date.now()
    });
    await loadReports();
    alert("تم حفظ البلاغ ✓");
    go("home");
  } catch (e) { alert("تعذّر الحفظ، تأكد من الإنترنت"); }
  $("saveBtn").disabled = false;
});

/* ===== السجل والإحصائيات ===== */
$("search").addEventListener("input", renderList);

function renderList() {
  const q = $("search").value.trim();
  const list = reports.filter(r => !q || String(r.no).includes(q) || String(r.name || "").includes(q));
  $("recList").innerHTML = list.length ? list.map(r => `
    <div class="rec">
      <div><strong>${esc(r.name || "بدون اسم")}</strong> <span class="muted">(${esc(r.no)})</span></div>
      <div class="muted">المرض: ${esc(r.disease)} · الحالة: ${esc(r.status)}</div>
      <div class="muted">التاريخ: ${esc(r.date)}</div>
    </div>`).join("") : '<div class="empty">لا توجد بلاغات</div>';
}

function renderStats() {
  const byD = {};
  reports.forEach(r => byD[r.disease] = (byD[r.disease] || 0) + 1);
  let html = `<div class="row"><span>إجمالي البلاغات</span><strong>${reports.length}</strong></div>`;
  Object.entries(byD).forEach(([k, v]) => html += `<div class="row"><span>${esc(k)}</span><strong>${v}</strong></div>`);
  $("statsBox").innerHTML = html;
}

/* ===== سطر الأدوات ===== */
const SCALES = [0.9, 1, 1.1, 1.2, 1.3];
let scaleIdx = Math.min(SCALES.length - 1, Math.max(0, +(localStorage.getItem("fIdx") || 1)));
function applyScale() { document.body.style.zoom = SCALES[scaleIdx]; localStorage.setItem("fIdx", scaleIdx); }
$("fMinus").addEventListener("click", () => { if (scaleIdx > 0) { scaleIdx--; applyScale(); } });
$("fPlus").addEventListener("click", () => { if (scaleIdx < SCALES.length - 1) { scaleIdx++; applyScale(); } });
applyScale();

if (localStorage.getItem("night") === "1") document.body.classList.add("dark");
$("nightBtn").addEventListener("click", () => {
  document.body.classList.toggle("dark");
  localStorage.setItem("night", document.body.classList.contains("dark") ? "1" : "0");
});

$("shareBtn").addEventListener("click", async () => {
  const url = location.href.split("?")[0];
  try {
    if (navigator.share) await navigator.share({ title: "المنصة القومية للتقارير الصحية", url });
    else { await navigator.clipboard.writeText(url); alert("تم نسخ الرابط"); }
  } catch (e) {}
});

let visits = +(localStorage.getItem("visits") || 0);
if (!sessionStorage.getItem("counted")) {
  sessionStorage.setItem("counted", "1");
  visits++;
  localStorage.setItem("visits", visits);
}
$("visits").textContent = visits;
</script>
</body>
</html>