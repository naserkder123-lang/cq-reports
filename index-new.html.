}
$("fMinus").onclick = () => { if (scaleIdx > 0) { scaleIdx--; applyScale(); } };
$("fPlus").onclick = () => { if (scaleIdx < SCALES.length - 1) { scaleIdx++; applyScale(); } };

function applyNight(on) {
  document.documentElement.dataset.theme = on ? "dark" : "light";
  localStorage.setItem("night", on ? "1" : "0");
}
applyNight(localStorage.getItem("night") === "1");
$("nightBtn").onclick = () => applyNight(document.documentElement.dataset.theme !== "dark");

$("shareBtn").onclick = async () => {
  const url = location.href.split("?")[0];
  try {
    if (navigator.share) await navigator.share({ title: ORG.line2, text: "رابط تطبيق التبليغ", url });
    else { await navigator.clipboard.writeText(url); toast("تم نسخ الرابط"); }
  } catch (e) { if (e.name !== "AbortError") toast("تعذّرت المشاركة"); }
};

async function countVisit() {
  const ref = db.collection("stats").doc("site");
  try {
    if (!sessionStorage.getItem("visited")) {
      sessionStorage.setItem("visited", "1");
      const s = await ref.get();
      if (!s.exists) await ref.set({ count: 1 });
      else await ref.update({ count: firebase.firestore.FieldValue.increment(1) });
    }
    const s2 = await ref.get();
    $("visits").textContent = "👁 الزوار: " + (s2.exists ? s2.data().count : 0);
  } catch (e) { $("visits").textContent = "👁 الزوار"; }
}
$("visits").onclick = countVisit;

applyScale();
countVisit();
fillDate();
</script>
