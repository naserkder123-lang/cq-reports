<script>
const firebaseConfig = {
  apiKey: "AIzaSyD4Iesxn_85M4cwfDkfrhezBkAFtx45xC0",
  authDomain: "cq-center-f7775.firebaseapp.com",
  projectId: "cq-center-f7775",
  storageBucket: "cq-center-f7775.firebasestorage.app",
  messagingSenderId: "779273740183",
  appId: "1:779273740183:web:789956f5c7d0d2ca0aaed2"
};
firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();

const MANAGERS = ["0910211755"];
const ORG = { line1: "إدارة الشؤون الصحية محلية أم القرى", line2: "إدارة الطوارئ الصحية ومكافحة الأوبئة" };
const $ = id => document.getElementById(id);
let me = null, reports = [], registering = false;

const normPhone = s => String(s || "").replace(/\D/g, "");
const emailOf = p => p + "@cq-center.app";
const ymd = d => new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function toast(msg) {
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(() => t.classList.remove("show"), 5000);
}

document.querySelectorAll("[data-contacts]").forEach(el =>
  el.innerHTML = MANAGERS.map(n => `<a class="btn blue" href="tel:${n}">📞 ${n}</a>`).join(""));

function showReg(on) {
  $("loginBox").classList.toggle("hidden", on);
  $("regBox").classList.toggle("hidden", !on);
}
$("showReg").onclick = () => showReg(true);
$("backLogin").onclick = () => showReg(false);

const ERR = {
  "auth/invalid-credential": "الرقم أو كلمة السر غير صحيحة",
  "auth/wrong-password": "كلمة السر غير صحيحة",
  "auth/user-not-found": "هذا الرقم غير مسجل، أنشئ حساباً جديداً",
  "auth/email-already-in-use": "هذا الرقم مسجل من قبل، سجّل الدخول",
  "auth/weak-password": "كلمة السر ضعيفة، استخدم 6 أحرف أو أكثر",
  "auth/too-many-requests": "محاولات كثيرة، انتظر قليلاً"
};
const errMsg = e => ERR[e.code] || "حدث خطأ، تأكد من الاتصال بالإنترنت";

$("loginBtn").onclick = async () => {
  const p = normPhone($("lPhone").value);
  if (p.length < 9) return toast("رقم التلفون غير صحيح");
  try { await auth.signInWithEmailAndPassword(emailOf(p), $("lPass").value); }
  catch (e) { toast(errMsg(e)); }
};

$("regBtn").onclick = async () => {
  const name = $("rName").value.trim();
  const p = normPhone($("rPhone").value);
  const pw = $("rPass").value;
  if (!name) return toast("اكتب الاسم");
  if (p.length < 9) return toast("رقم التلفون غير صحيح");
  if (pw !== $("rPass2").value) return toast("كلمتا السر غير متطابقتين");
  registering = true;
  try {
    const cred = await auth.createUserWithEmailAndPassword(emailOf(p), pw);
    await db.collection("users").doc(cred.user.uid).set({ name, phone: p, isManager: false });
    registering = false;
    await enter(cred.user.uid);
  } catch (e) {
    if (e.code === "auth/email-already-in-use") {
      try {
        const cred = await auth.signInWithEmailAndPassword(emailOf(p), pw);
        const ref = db.collection("users").doc(cred.user.uid);
        const s = await ref.get();
        if (!s.exists) await ref.set({ name, phone: p, isManager: false });
        registering = false;
        await enter(cred.user.uid);
        return;
      } catch (e2) {
        registering = false;
        return toast("هذا الرقم مسجل بكلمة سر مختلفة، سجّل الدخول بها");
      }
    }
    registering = false;
    toast(errMsg(e));
  }
};

$("logoutBtn").onclick = () => auth.signOut();

auth.onAuthStateChanged(async user => {
  if (registering) return;
  if (!user) {
    me = null;
    $("app").classList.add("hidden");
    $("auth").classList.remove("hidden");
    return;
  }
  await enter(user.uid);
});

async function enter(uid) {
  const snap = await db.collection("users").doc(uid).get();
  if (!snap.exists) {
    const name = prompt("اكتب اسمك لإكمال الحساب") || "مستخدم";
    const phone = normPhone(auth.currentUser.email.split("@")[0]);
    await db.collection("users").doc(uid).set({ name, phone, isManager: false });
    return enter(uid);
  }
  me = { uid, ...snap.data() };
  $("auth").classList.add("hidden");
  $("app").classList.remove("hidden");
  $("welcome").textContent = "مرحباً " + me.name + (me.isManager ? " — مدير" : "");
  // إظهار زر المستخدمين والصلاحيات لإدارة المحلية فأعلى فقط
  if (me.isManager) { $("usersBtn").style.display = "block"; }
  await loadReports();
  go("home");
}

async function loadReports() {
  const q = me.isManager
    ? db.collection("reports")
    : db.collection("reports").where("owner", "==", me.uid);
  const snap = await q.get();
  reports = snap.docs
    .map(d => ({ id: d.id, ...d.data() }))
    .sort((a, b) => (b.created || 0) - (a.created || 0));
}

function go(v) {
  document.querySelectorAll("[data-view]").forEach(el =>
    el.classList.toggle("hidden", el.dataset.view !== v));
  if (v === "new") fillDate();
  if (v === "list") renderList();
  if (v === "stats") renderStats();
  window.scrollTo(0, 0);
}
document.querySelectorAll("[data-go]").forEach(b => b.onclick = () => go(b.dataset.go));

function fillDate() {
  if (!$("date").value) $("date").value = ymd(new Date());
}
$("empNo").addEventListener("change", async () => {
  const no = $("empNo").value.trim();
  if (!no) return;
  try {
    const s = await db.collection("emps").doc(no).get();
    if (s.exists) { $("empName").value = s.data().name; $("dept").value = s.data().dept || ""; }
  } catch (e) {}
});
$("disease").addEventListener("change", () => {
  $("otherWrap").classList.toggle("hidden", $("disease").value !== "أخرى");
});

$("saveBtn").onclick = async () => {
  const no = $("empNo").value.trim();
  const name = $("empName").value.trim();
  const dept = $("dept").value.trim();
  let dz = $("disease").value;
  if (dz === "أخرى") dz = $("otherDisease").value.trim();
  if (!no) return toast("أدخل الرقم الوظيفي");
  if (!/^\d+$/.test(no)) return toast("الرقم الوظيفي أرقام فقط");
  if (!dz) return toast("أدخل اسم المرض");

  $("saveBtn").disabled = true;
  try {
    if (name) await db.collection("emps").doc(no).set({ name, dept });
    await db.collection("reports").add({
      owner: me.uid, by: me.name, state: $("state").value, locality: $("locality").value, unit: $("state").value === "ولاية الجزيرة" ? $("unit").value : "", no, name, dept, disease: dz,
      date: $("date").value, status: $("status").value,
      symptoms: $("symptoms").value.trim(), notes: $("notes").value.trim(),
      created: Date.now()
    });
    await loadReports();
    resetForm();
    toast("تم حفظ البلاغ ✓");
  } catch (e) {
    toast("تعذّر الحفظ، تأكد من الإنترنت");
  }
  $("saveBtn").disabled = false;
};

function resetForm() {
  ["empNo", "empName", "dept", "otherDisease", "symptoms", "notes"].forEach(id => $(id).value = "");
  $("disease").value = "ملاريا";
  $("otherWrap").classList.add("hidden");
  $("status").value = "مشتبه به";
  $("date").value = ymd(new Date());
}

$("search").addEventListener("input", renderList);
$("fState").addEventListener("change", renderList);
function renderList() {
  const q = $("search").value.trim();
  const list = reports.filter(r =>
    (!q || String(r.no).includes(q) || (r.name || "").includes(q)) && (!$("fState").value || r.state === $("fState").value));
  if (!list.length) { $("recList").innerHTML = '<div class="empty">لا توجد بلاغات</div>'; return; }
  $("recList").innerHTML = list.map(r => `
    <div class="rec">
      <div><strong>${esc(r.name || "بدون اسم")}</strong> <span class="badge">${esc(r.no)}</span>${r.state ? ` <span class="badge">${esc(r.state)}</span>` : ""}${r.locality ? ` <span class="badge">${esc(r.locality)}</span>` : ""}${r.unit ? ` <span class="badge">${esc(r.unit)}</span>` : ""}</div>
      <div class="muted">${esc(r.dept)}${r.dept ? " — " : ""}${esc(r.disease)} <span class="badge">${esc(r.status)}</span></div>
      <div class="muted">التاريخ: ${esc(r.date)} · سجّله: ${esc(r.by)}</div>
      ${r.symptoms ? `<div class="muted">الأعراض: ${esc(r.symptoms)}</div>` : ""}
      ${r.notes ? `<div class="muted">ملاحظات: ${esc(r.notes)}</div>` : ""}
      <div style="margin-top:8px"><button class="small del" onclick="delReport('${r.id}')">حذف</button></div>
    </div>`).join("");
}

async function delReport(id) {
  if (!confirm("هل تريد حذف هذا البلاغ؟")) return;
  try {
    await db.collection("reports").doc(id).delete();
    await loadReports();
    renderList();
    toast("تم الحذف");
  } catch (e) {
    toast("لا تملك صلاحية حذف هذا البلاغ");
  }
}

function renderStats() {
  const emp = new Set(reports.map(r => r.no)).size;
  const byD = {}, byS = {};
  reports.forEach(r => {
    byD[r.disease] = (byD[r.disease] || 0) + 1;
    byS[r.status] = (byS[r.status] || 0) + 1;
  });
  const row = (l, v) => `<div class="stat"><span>${esc(l)}</span><strong>${v}</strong></div>`;
  const block = obj => Object.keys(obj).length
    ? Object.entries(obj).map(([k, v]) => row(k, v)).join("")
    : '<div class="empty">لا توجد بيانات بعد</div>';
  $("statsBox").innerHTML =
    `<h3>ملخص عام</h3>` + row("إجمالي البلاغات", reports.length) + row("عدد الموظفين", emp) +
    `<h3 style="margin-top:16px">حسب المرض</h3>` + block(byD) +
    `<h3 style="margin-top:16px">حسب الحالة</h3>` + block(byS);
}

