<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>المنصة القومية للتقارير الصحية</title>
<style>
:root{--bg:#eef3f8;--card:#fff;--text:#1d2630;--muted:#667085;--border:#d9e0e8;--pri:#1560c7;--pri-d:#0b3a7a;--line:#7fb8ff;--ghost:#eef3f8;--ghost-t:#0b3a7a}
body.dark{--bg:#15191e;--card:#1f252c;--text:#e8edf2;--muted:#9aa5b1;--border:#333c46;--ghost:#2a3441;--ghost-t:#e8edf2}
*{box-sizing:border-box}
body{margin:0;font-family:Tahoma,Arial,sans-serif;background:var(--bg);color:var(--text);padding:10px;transition:background .2s}
.hidden{display:none!important}
main{max-width:520px;margin:auto}

/* الترويسة */
.hdr{display:grid;grid-template-columns:50px 1fr 50px;gap:8px;align-items:center;background:linear-gradient(#2a7fe0,var(--pri-d));color:#fff;border-radius:16px;padding:8px;border:3px solid var(--pri-d);box-shadow:0 0 0 2px var(--line) inset,0 4px 10px rgba(11,58,122,.25)}
.corner{width:50px;height:50px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden}
.corner img{width:100%;height:100%;object-fit:contain;padding:3px}
.corner-empty{background:rgba(255,255,255,.12);border:2px dashed rgba(255,255,255,.6)}
.hdr-txt{text-align:center;line-height:1.5}
.hdr .gov{font-size:11px;opacity:.9}
.hdr .lvl{font-size:13px;font-weight:bold;color:#ffe066}
.hdr h1{margin:2px 0;font-size:15px}
.hdr small{display:block;font-size:11px;opacity:.9}

/* سطر الأدوات */
.tools{display:flex;gap:5px;margin:8px 0}
.tool{flex:1;min-height:32px;padding:4px 2px;border:none;border-radius:9px;font-family:inherit;font-size:11px;font-weight:bold;color:#fff;background:linear-gradient(#2a6fd6,var(--pri-d));box-shadow:0 3px 0 #06234d;cursor:pointer;white-space:nowrap}
.tool.fs{flex:0 0 auto;min-width:34px;font-size:13px}
.tool.night{background:linear-gradient(#4a5568,#1a202c)}

/* الأزرار */
.btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:48px;width:100%;padding:12px;border:none;border-radius:14px;font-family:inherit;font-size:16px;font-weight:bold;color:#fff;cursor:pointer;text-decoration:none;box-shadow:0 5px 0 var(--pri-d);margin-top:10px}
.btn:active{transform:translateY(4px)}
.b-red{background:linear-gradient(#ff6a5e,#d82a1e);box-shadow:0 5px 0 #8e110a}
.b-blue{background:linear-gradient(#3fa4ff,#1560c7)}
.b-yellow{background:linear-gradient(#ffe066,#e8ad00);color:#2a2000;box-shadow:0 5px 0 #9a7400}
.b-green{background:linear-gradient(#4cd47a,#1e9a4a);box-shadow:0 5px 0 #0f6a31}
.b-gray{background:linear-gradient(#8a96a6,#56627a);box-shadow:0 5px 0 #333d4f}
.b-ghost{background:var(--ghost);color:var(--ghost-t);box-shadow:0 3px 0 #c8d3e0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid .full{grid-column:span 2}
.grid .btn{margin-top:0}

/* البطاقات والنماذج */
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:14px;margin-top:12px}
.card h3{margin:0 0 8px}
.muted{color:var(--muted);font-size:13px;line-height:1.7}
input,select,textarea{width:100%;padding:12px;border:1px solid var(--border);border-radius:10px;font-size:16px;margin-bottom:8px;font-family:inherit;background:var(--bg);color:var(--text)}
label{display:block;margin:8px 0 4px;font-size:14px;color:var(--muted)}
.rec{border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:8px}
.row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border)}
.empty{text-align:center;color:var(--muted);padding:20px}
.screen{display:none;margin-top:12px}
.screen.on{display:block}
.back{background:none;border:none;color:var(--pri);font-size:15px;font-weight:bold;cursor:pointer;margin-bottom:8px;padding:6px 0;font-family:inherit}
.contact{display:block;background:var(--pri);color:#fff;text-align:center;padding:12px;border-radius:10px;text-decoration:none;margin-bottom:8px;font-weight:bold}

/* تجربة الأدوار */
.demo{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.demo button{flex:1;min-width:30%;padding:9px;border:1px solid var(--border);border-radius:10px;background:var(--card);color:var(--text);font-family:inherit;font-size:13px;cursor:pointer}
.demo button.on{background:var(--pri);color:#fff;border-color:var(--pri)}

/* الصلاحيات حسب الدور */
body[data-role="center"] [data-min],
body[data-role="lab"] [data-min],
body[data-role="entry"] [data-min]{display:none!important}
body[data-role="locality"] [data-min="state"],
body[data-role="locality"] [data-min="ministry"]{display:none!important}
body[data-role="state"] [data-min="ministry"]{display:none!important}
</style>
</head>
